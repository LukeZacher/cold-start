{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Resend": {
    "RegistrationConfirmationTemplateId": "5fde46c0-a0ea-4ecb-84dd-01e13d7877ee"
  },
  "Auth": {
    "TokenLifespanHours": 24,
    "ResendAccountConfirmationMailCooldownSeconds": 60
  },
  "IdentityPolicy": {
    "PasswordRequiredLength": 8,
    "MaxFailedAccessAttempts": 10,
    "LockoutMinutes": 5
  }
}
